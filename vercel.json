{
  "version": 2,
  "functions": {
    "api/payments/*.js": {
      "runtime": "nodejs24.x"
    }
  },
  "routes": [
    {
      "src": "/api/payments/(.*)",
      "dest": "/api/payments/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/login.html"
    }
  ]
}