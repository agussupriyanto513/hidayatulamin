{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/",                    "dest": "/login.html" },
    { "src": "/login",               "dest": "/login.html" },
    { "src": "/pi-donasi",           "dest": "/pi-donasi.html" },
    { "src": "/dashboard-admin",     "dest": "/dashboard-admin.html" },
    { "src": "/dashboard-wali",      "dest": "/dashboard-wali.html" },
    { "src": "/dashboard-santri",    "dest": "/dashboard-santri.html" },
    { "src": "/dashboard-ustadz",    "dest": "/dashboard-ustadz.html" },
    { "src": "/auth.js",             "dest": "/auth.js" },
    { "src": "/(.*)",                "dest": "/$1" }
  ]
}
